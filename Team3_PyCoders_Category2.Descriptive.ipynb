   "source": [
    "\n",
    "# BMI analysis\n",
    "bmi_series = hf_df[\"bmi\"].dropna()\n",
    "\n",
    "# Summary statistics\n",
    "print(\"BMI summary statistics:\")\n",
    "print(bmi_series.describe().round(2))\n",
    "\n",
    "# BMI category breakdown\n",
    "bmi_categories = pd.cut(\n",
